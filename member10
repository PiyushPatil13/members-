function buildQuickStatsSection(sheet, startRow) {
  sheet.getRange(startRow, 1, 1, 9).merge().setValue('QUICK STATS').setFontWeight('bold').setFontColor('#FFFFFF').setBackground('#1F4E79');
  
  const r = startRow + 1;
  sheet.getRange(r, 1).setValue('Active Tasks').setFontWeight('bold').setBackground('#EAF0F6');
  sheet.getRange(r, 2, 1, 2).merge().setFormula(`=COUNTIFS('Master Task Sheet'!D:D, "${CONFIG.MEMBER_NAME}", 'Master Task Sheet'!H:H, "<>Completed")`);

  sheet.getRange(r, 4).setValue('Total Hours Logged').setFontWeight('bold').setBackground('#EAF0F6');
  sheet.getRange(r, 5, 1, 2).merge().setFormula(`=SUMIF('Time & Burn Log'!C:C, "${CONFIG.MEMBER_NAME}", 'Time & Burn Log'!F:F)`);

  sheet.getRange(r, 7).setValue('Completed Tasks').setFontWeight('bold').setBackground('#EAF0F6');
  sheet.getRange(r, 8, 1, 2).merge().setFormula(`=COUNTIFS('Master Task Sheet'!D:D, "${CONFIG.MEMBER_NAME}", 'Master Task Sheet'!H:H, "Completed")`);

  sheet.getRange(startRow, 1, 2, 9).setBorder(true, true, true, true, true, true, '#D0D7DE', SpreadsheetApp.BorderStyle.SOLID);
}

