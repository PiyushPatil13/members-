function styleDataSheet(sheet, columns) {
  sheet.getRange(1, 1, 1, columns)
    .setBackground('#1F4E79').setFontColor('#FFFFFF').setFontWeight('bold').setFontFamily(CONFIG.FONT);

  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 100, columns).setFontFamily(CONFIG.FONT);
  sheet.getRange(1, 1, 100, columns).setBorder(true, true, true, true, true, true, '#D0D7DE', SpreadsheetApp.BorderStyle.SOLID);
  sheet.autoResizeColumns(1, columns);

  if (columns >= 8) {
    sheet.setColumnWidth(3, 300);
    sheet.setColumnWidth(7, 220);
    sheet.setColumnWidth(8, 250);
  }
}

