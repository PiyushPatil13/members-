function startTimerForRow(sheet, activeRow) {
  const currentStatus = sheet.getRange(activeRow, 7).getValue();
  if (currentStatus === 'RUNNING') {
    SpreadsheetApp.getUi().alert('Timer is already running for this row!');
    sheet.getRange(activeRow, 8).setValue(false);
    return;
  }

  const startTime = new Date();
  sheet.getRange(activeRow, 4).setValue(startTime).setNumberFormat('hh:mm:ss a');
  sheet.getRange(activeRow, 5).setValue('—');
  sheet.getRange(activeRow, 7).setValue('RUNNING').setFontColor('#008000');
  
  // Uncheck Start Checkbox button
  sheet.getRange(activeRow, 8).setValue(false);
  sheet.getRange(activeRow, 9).setValue(false);
  
  PropertiesService.getDocumentProperties().setProperty('TIMER_START_ROW_' + activeRow, startTime.getTime().toString());

  SpreadsheetApp.getUi().alert(`Timer STARTED for Row \({sheet.getRange(activeRow, 1).getValue()} at\){Utilities.formatDate(startTime, Session.getScriptTimeZone(), 'hh:mm:ss a')}`);
}

