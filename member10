function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Member Workspace')
    .addItem('Setup / Refresh Workspace', 'setupMemberWorkspace')
    .addSeparator()
    .addItem('▶ Start Timer (Selected Row)', 'startSelectedTimer')
    .addItem('⏹ Stop & Log Timer (Selected Row)', 'stopSelectedTimer')
    .addItem('🔄 Reset Selected Row', 'resetSelectedTimer')
    .addItem('➕ Add Tracker Row', 'addTrackerRow')
    .addSeparator()
    .addItem('Test Team Tracker Connection', 'testTeamTrackerConnection')
    .addToUi();
}

/**
 * AUTOMATIC SIDE-BY-SIDE BUTTON TRIGGER
 * - Checking Column H (Start) -> Starts Timer
 * - Checking Column I (Stop)  -> Stops & Logs Timer
 */
function onEdit(e) {
  if (!e || !e.range) return;
  
  const sheet = e.range.getSheet();
  if (sheet.getName() !== 'My Workspace') return;

  const col = e.range.getColumn();
  const row = e.range.getRow();

  const quickStatsFinder = sheet.createTextFinder('QUICK STATS').findNext();
  if (!quickStatsFinder) return;
  const quickStatsRow = quickStatsFinder.getRow();

  if (row <= 17 || row >= quickStatsRow) return;

  const val = e.range.getValue();

  // Column H = Start Button
  if (col === 8 && val === true) {
    startTimerForRow(sheet, row);
  }

  // Column I = Stop Button
  if (col === 9 && val === true) {
    stopTimerForRow(sheet, row);
  }
}

function setupMemberWorkspace() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const connection = testTeamTrackerConnection();
  if (!connection) {
    SpreadsheetApp.getUi().alert(
      'Team Tracker connection failed.\n\nOpen the "Connection Test" sheet to review the error.'
    );
    return;
  }

  createLinkedSheets(ss);
  buildDashboard(ss);
  buildMyProjects(ss);
  buildMyTasks(ss);
  buildMyHours(ss);

  const dashboard = ss.getSheetByName('My Workspace');
  if (dashboard) {
    ss.setActiveSheet(dashboard);
    ss.moveActiveSheet(1);
  }

  SpreadsheetApp.getUi().alert(
    'MEM-02 Workspace created.\n\nCheck "▶ Start" in Column H to start, or "⏹ Stop" in Column I to log hours.'
  );
}

function testTeamTrackerConnection() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('Connection Test') || ss.insertSheet('Connection Test');
  sheet.clear();

  sheet.getRange('A1:D1').merge()
    .setValue('CVA STUDIO — TEAM TRACKER CONNECTION TEST')
    .setFontFamily(CONFIG.FONT).setFontSize(16).setFontWeight('bold')
    .setBackground('#1F4E79').setFontColor('#FFFFFF');

  sheet.getRange('A3').setValue('Team Tracker URL').setFontWeight('bold');
  sheet.getRange('B3:D3').merge().setValue(CONFIG.TEAM_TRACKER_URL);

  try {
    const source = SpreadsheetApp.openByUrl(CONFIG.TEAM_TRACKER_URL);
    sheet.getRange('A5').setValue('Connection Status').setFontWeight('bold');
    sheet.getRange('B5').setValue('CONNECTED').setFontWeight('bold');
    sheet.getRange('A6').setValue('Source Spreadsheet').setFontWeight('bold');
    sheet.getRange('B6').setValue(source.getName());

    const sourceSheets = source.getSheets().map(s => [s.getName()]);
    sheet.getRange('A8').setValue('Available Source Sheets').setFontWeight('bold');
    sheet.getRange(9, 1, sourceSheets.length, 1).setValues(sourceSheets);

    sheet.getRange('A1:D20').setFontFamily(CONFIG.FONT);
    sheet.autoResizeColumns(1, 4);
    return true;
  } catch (error) {
    sheet.getRange('A5').setValue('Connection Status').setFontWeight('bold');
    sheet.getRange('B5:D5').merge().setValue('FAILED').setFontWeight('bold');
    sheet.getRange('A7').setValue('Error').setFontWeight('bold');
    sheet.getRange('B7:D10').merge().setValue(error.message);
    sheet.getRange('A1:D20').setFontFamily(CONFIG.FONT);
    sheet.autoResizeColumns(1, 4);
    return false;
  }
}

function createLinkedSheets(ss) {
  const sources = [
    { name: 'Team Directory', range: 'A1:C100' },
    { name: 'Project Master (View)', range: 'A1:I1000' },
    { name: 'Master Task Sheet', range: 'A1:I1000' },
    { name: 'Time & Burn Log', range: 'A1:G1000' }
  ];

  sources.forEach(source => {
    let sheet = ss.getSheetByName(source.name) || ss.insertSheet(source.name);
    sheet.clear();

    const formula = `=IMPORTRANGE("\({CONFIG.TEAM_TRACKER_URL}", "\){source.name}!${source.range}")`;
    sheet.getRange('A1').setFormula(formula);
    sheet.getRange('A1:I1000').setFontFamily(CONFIG.FONT);
    sheet.setFrozenRows(1);
  });
}

